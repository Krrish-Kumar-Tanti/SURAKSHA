# SURAKSHA Backend Environment Variables
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://suraksha:suraksha@localhost:5432/suraksha

# JWT
JWT_SECRET=suraksha-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600

# Document encryption
DOCUMENT_MASTER_KEY=base64-32-byte-key

# CORS
CORS_ORIGINS=http://localhost:5173

# Demo mode
DEMO_MODE=true

# Seed dataset
SEED_DATASET=demo_v1

# APScheduler
AP_SCHEDULER_API_ENABLED=true