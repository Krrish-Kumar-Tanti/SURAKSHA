# SURAKSHA Backend Environment Variables
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://suraksha:suraksha@localhost:5432/suraksha

# JWT
JWT_SECRET=suraksha-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600

# Document encryption
# Copy this file to backend/.env, then paste a generated key after DOCUMENT_MASTER_KEY=.
# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DOCUMENT_MASTER_KEY=
DOCUMENT_STORAGE_DIR=./var/documents

# Gemini OCR
# Set this in backend/.env. Gemini receives the uploaded document for OCR processing.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://127.0.0.1:3000"]

# Demo mode
DEMO_MODE=true

# Seed dataset
SEED_DATASET=demo_v1

# APScheduler
AP_SCHEDULER_API_ENABLED=true